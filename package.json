{
  "name": "syncwatch",
  "version": "0.3.0",
  "description": "P2P 同步观影分发软件 — 边下边播，播放位置优先调度，全员缓冲联动",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "signal": "node signaling-server/server.js",
    "test": "node --test",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "predist": "npm run prepare:runtime",
    "dist": "npm run dist:offline && npm run dist:web",
    "dist:offline": "electron-builder --win nsis",
    "dist:web": "electron-builder --win nsis-web"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "compression": "maximum",
    "appId": "com.syncwatch.app",
    "productName": "SyncWatch",
    "win": {
      "target": "nsis",
      "artifactName": "SyncWatch-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncWatch"
    },
    "nsisWeb": {
      "artifactName": "SyncWatch-WebSetup-${version}.${ext}",
      "appPackageUrl": "https://github.com/Felis-desuwa/SyncWatch/releases/download/v${version}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncWatch"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": ["mpv.exe", "yt-dlp.exe"]
      }
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
